{
    "name": "roro/roroform",
    "description": "Form helper for laravel.",
    "type": "library",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "RoroForm\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoroForm\\RoroFormServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    }
}
