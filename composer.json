{
    "name": "roro/roroform",
    "description": "Form helper for laravel.",
    "type": "library",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "RoroForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoroForm\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoroForm\\RoroFormServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    }
}
